{% if not isTimePaused %}
     {% set sexlab = sexlab_get_threads(npc.UUID) -%}
     {% set sexlab.source = "sexlab_get_threads" %} 
     {% if not sexlab.threads %}
          {% set sexlab = read_json("SkyrimNet_SexLab/threads.json") %} 
          {% set sexlab.source = "file" %} 
     {% endif %}
{% else %} 
     {% set sexlab = read_json("SkyrimNet_SexLab/threads.json") %} 
     {% set sexlab.source = "file" %}
{% endif %}
{# ---------------------------------- #} 
{% set speaker = {"speaking_modifiers":[], "victim":0, "notice_level":0, "active":false, "arousal":0} %}
{# Sex is hard work: names per stamina regen tier in the speaker's live thread #}
{% set _fatigue = {"breath":[], "tired":[], "spent":[]} %}
{% if existsIn(sexlab,"threads") and length(sexlab.threads) > 0 %}
     {% for thread in sexlab.threads %}
          {% set _thread_live = false %}
          {% for actor_record in thread.actors %}
               {% if is_in_faction(to_number(actor_record.uuid), "SexLabAnimatingFaction") or is_in_faction(to_number(actor_record.uuid), "OStimActorCountFaction") or is_in_faction(to_number(actor_record.uuid), "DOMActionMasturbating") %}
                    {% set _thread_live = true %}
               {% endif %}
          {% endfor %}
          {% if _thread_live %}
          {% set _has_npc = false %}
          {% for actor_record in thread.actors %}
               {% if to_number(actor_record.uuid) == npc.UUID %}
                    {% set _has_npc = true %}
                    {% set speaker = actor_record %}
                    {% if get_faction_rank(npc.UUID, "SexLabAnimatingFaction") == 1 %}
                         {% set speaker.active = true %}
                         {% set speaker.notice_level = 2 %}
                    {% endif %}
               {% endif %}
          {% endfor %}
          {% if _has_npc %}
               {% for actor_record in thread.actors %}
                    {% if existsIn(actor_record, "stamina_regen") and existsIn(actor_record, "name") %}
                         {% if actor_record.stamina_regen <= 0 %}
                              {% set _fatigue.spent = append(_fatigue.spent, actor_record.name) %}
                         {% else if actor_record.stamina_regen <= 40 %}
                              {% set _fatigue.tired = append(_fatigue.tired, actor_record.name) %}
                         {% else if actor_record.stamina_regen < 90 %}
                              {% set _fatigue.breath = append(_fatigue.breath, actor_record.name) %}
                         {% endif %}
                    {% endif %}
               {% endfor %}
          {% endif %}
          {% endif %}
     {% endfor %}
{% endif %}
{% if length(_fatigue.breath) == 1 %}
{{ join(_fatigue.breath, "") }} is breathing hard.
{% else if length(_fatigue.breath) > 1 %}
{{ join(_fatigue.breath, " and ") }} are breathing hard.
{% endif %}
{% if length(_fatigue.tired) == 1 %}
{{ join(_fatigue.tired, "") }} is tired.
{% else if length(_fatigue.tired) > 1 %}
{{ join(_fatigue.tired, " and ") }} are tired.
{% endif %}
{% if length(_fatigue.spent) == 1 %}
{{ join(_fatigue.spent, "") }} is exhausted.
{% else if length(_fatigue.spent) > 1 %}
{{ join(_fatigue.spent, " and ") }} are exhausted.
{% endif %}
{# ---------------------------------- #}
{# Missing/null on recreated slots: contains() requires an array #}
{% if not speaker.speaking_modifiers %}{% set speaker.speaking_modifiers = [] %}{% endif %}
{% if speaker.active %} 
Don't describe yourself to yourself.
