{# ----------------------------------------------------- #} 
{# Loads the active sex acts                             #}
{#    If sex is active attempt to load sexlab            #}
{#      If game paused load the cached file              #} 
{#      else call the decorator                          #} 
{# ----------------------------------------------------- #} 
{% if not isTimePaused %}
     {% set sexlab = sexlab_get_threads(npc.UUID) -%}
     {% set sexlab.source = "sexlab_get_threads" %} 
     {% if not sexlab.threads %}
          {% set sexlab = read_json("SkyrimNet_SexLab/threads.json") %} 
          {% set sexlab.source = "file" %} 
     {% endif %}
{% else %} 
     {% set sexlab = read_json("SkyrimNet_SexLab/threads.json") %} 
     {% set sexlab.source = "file" %}
{% endif %}

{% set speaker = {"speaking_modifiers":[], "victim":0, "notice_level":0, "active":false} %}

{% if existsIn(sexlab,"threads") and length(sexlab.threads) > 0 %}
     {% for thread in sexlab.threads %}
          {% set _notice_level = 0 %} 

          {% if _notice_level != 2 %} 
               {% if thread.speaker_los %}
                    {% if thread.speaker_distance < 12 %} 
                         {% set _notice_level = 2 %} 
                    {% else if thread.speaker_distance < 36 %} 
                         {% set _notice_level = 1 %}
                    {% endif %} 
               {% endif %} 
          {% endif %} 

          
          {% set _includes_creatures = false %} 
          {%- for actor_record in thread.actors %} 
               {% if to_number(actor_record.uuid) == npc.UUID %}
                    {% set speaker = actor_record %}
                    {% set _notice_level = 2 %} 
                    {% set speaker.active = true %}
                    {% set speaker.notice_level = 2 %}
               {% endif %}
               {% if actor_record.creature_description != "" %} 
                    {% set _includes_creatures = True %} 
               {% endif %} 
          {% endfor %} 

          {% if _notice_level == 2 %}
               - {% if thread.location != "" %} On {{thread.location}},{% endif %} {{ thread.description }} {%- 
                    for actor_record in thread.actors %} {% 
                         if actor_record.is_hermaphrodiate %} {{ actor_record.name }} is a hermaphrodiate. {% endif %} {% 
                         if actor_record.creature_description != "" %} {{ actor_record.creature_description }} {% endif %} {% 
                         if actor_record.wearing_strapon %} {{ actor_record.name }} is wearing a strap on dildo. {% endif %}
                    {% endfor %} 
          {% else if _notice_level == 1 %} 
               - You can tell someone is having sex{% if _includes_creatures %}, which includes creatures{% endif %}.
          {% endif %}
     {%- endfor -%}
{% endif %} 
{% if speaker.notice_level > 1 %} 
**Reaction must evolve—don't loop on the same observation.**
     {% if speaker.active %}
          {% if contains(speaker.speaking_modifiers,"_pleasure_") or contains(speaker.speaking_modifiers,"_pain_") %}
               {% if speaker.victim == 1 %} 
You are physically engaged in non-consensual, often violent violation, intense physical activity right now.
Match your feelings of fear, resistance, anger, dissociation, bargaining, survival coping.
 
               {% else %} 
You are physically engaged in consensual intense physical activity right now.
Match your feelings of desire, vulnerability, playfulness, intensity, connection, and desperation.
               {% endif %}
         {% endif %} 
         {% if is_narration_enabled() %}
         {% endif %}
         {% if length(speaker.speaking_modifiers) > 0 %} 
         
**Speaking Rules**:
               {% if contains(speaker.speaking_modifiers,"_pleasure_") or contains(speaker.speaking_modifiers, "_pain_") %}
- Your mind is overwhelmed by physical {% if contains(speaker.speaking_modifiers, "_pleasure_") %} pleasure {% endif %} {% if contains(speaker.speaking_modifiers,"_pain_") %} pain {% endif %} 
               {% endif %} 
               {% if contains(speaker.speaking_modifiers,"_gagged_") %} 
- Your mouth is blocked, you can only communicate 1 to 3 vocalizations ahh, hahh, hoooh, huh, ahh!, or similar
               {% else if contains(speaker.speaking_modifiers,"_pleasure_") or contains(speaker.speaking_modifiers, "_pain_") %}
                      {% if contains(speaker.speaking_modifiers,"_pleasure_") %}
    - Your dialogue contains one to two vocalizations ( hahh!, huuhh, hooh, ahh )
                      {% else %} 
    - Your dialogue contains one to two vocalizations ( hahh!, ow!, iyaa!, huh!, hooohh, ouch! )
                      {% endif %} 
- You are distracted, you can only speak 9 words or less (vocalizations don't count).
               {% else if contains(speaker.speaking_modifiers, "_kissing_") %} 
- Your mouth is busy kissing, rephrase spoken words down to 5 words or less!
                {% else %} 
- You can speak normally, do not include a vocalization, unless it is truly needed.
               {% endif %} 
        {% endif %}
     {% else %} 
After your first acknowledgment, either act on it, dismiss it, or let it color your responses subtly—don't keep narrating that it's happening.
     {% endif %}

    {% if get_global_value("SkyrimNet_SexLab_hide_dialogue_historic_instructions") != 1.0 %}
** Dialogue and Internal Thoughts Style Reminder
- Use fantasy / medieval historical language appropriate for Skyrim
- NEVER use modern slang or language
- Use racial speech patterns, slang and idioms, racial cultural views
- Match the speaker's medieval social hierarchy position
     {% endif %} 

** Length Remember Reminder
{% if is_narration_enabled() and speaker.active %}
- The final response can include only 2 sentences. One narration (no more than 20 words) and dialogue sentence (it can be only vocalizations).
- Narration should move the action forward
{% endif %} 
- If dialog has nothing new to say, replace with non-verbals.
- Your dialog must NEVER use dots ".", only commas "," , the Text-To-Speech fails to pronounce them correctly
- Your response must be a clear understandable idea
- Internal Dialogue must never just repeat the spoken dialogue

{% endif %}