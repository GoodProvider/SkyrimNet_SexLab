Function AddSlave(Actor Hooker)
	Debug.trace("TDF AddSlave "+Hooker)
	SetProperties()
	if PAH != None
		if Hooker.IsInFaction(PAHHasBeenPlayerSlaveFaction)
			Debug.Notification("paradise halls ex-Slave detected")
			PAH.AddSlave(Hooker)
			return
		endif
 	EndIf
	if DOM01 != None
		if Hooker.IsInFaction(DOMHistoryFaction)
			Debug.Notification("DOM ex-actor detected")
			DOM01.MoveNPCToDOM(Hooker)
			return
		endif
	endif
EndFunction

