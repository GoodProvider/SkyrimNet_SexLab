Function SetProperties()
	if (Game.GetModByName("paradise_halls.esm") != 255)
		if PAH == None 	
			PAH = Game.GetFormFromFile(0x01FAEF, "paradise_halls.esm") As PAHCore
			PAHPlayerSlaveFaction = PAH.PAHPlayerSlaveFaction
			PAHHasBeenPlayerSlaveFaction = PAH.PAHHasBeenPlayerSlaveFaction
		endif
	else
		PAH = None
	endif
	if (Game.GetModByName("DiaryOfMine.esm") != 255)
		if DOM01 == None
			DOM01 = Game.GetFormFromFile(0x000D61, "DiaryOfMine.esm") As DOM_Core
			DOMActorFaction = DOM01.DOMActorFaction
			DOMHistoryFaction = DOM01.DOMHistoryFaction
		endif
	else
		DOM01 = None
	endif
EndFunction

Function ReleaseSlave(Actor Hooker)
	Debug.trace("TDF ReleaseSlave "+Hooker)
	SetProperties()
	if PAH != None
		if Hooker.IsInFaction(PAHPlayerSlaveFaction)
			Debug.Notification("paradise halls Slave detected")
			PAH.GetSlave(Hooker).Release()
			Hooker.EvaluatePackage()
			return
		endif
 	EndIf
	if DOM01 != None
		if Hooker.IsInFaction(DOMActorFaction)
			Debug.Notification("DOM actor detected")
			DOM01.ReleaseActor(Hooker)
			Hooker.EvaluatePackage()
			return
		endif
	endif
EndFunction

