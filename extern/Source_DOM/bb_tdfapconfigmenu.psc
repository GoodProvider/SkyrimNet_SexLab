Event OnOptionKeyMapChange(int option, int keyCode, string conflictControl, string conflictName)
	if (option == BB_PlayerAutoWhoreHotkeyOption)
		if (conflictControl != "")
			if ShowMessage("Key is already bound to: " + conflictControl + "\nAre you sure you want to bind it?\nIt won't overwrite the control")
				BB_PlayerAutoWhoreHotkey.SetValue(keyCode)
				SetKeyMapOptionValue(BB_PlayerAutoWhoreHotkeyOption, keyCode)
				(HotkeyQuest as BB_TDFEnhanced_Hotkeys).SetKey(keyCode)
			EndIf		
		else
			SetKeyMapOptionValue(option, keyCode)
			BB_PlayerAutoWhoreHotkey.SetValue(keyCode)
			(HotkeyQuest as BB_TDFEnhanced_Hotkeys).SetKey(keyCode)
		endIf
	endif	
endEvent






