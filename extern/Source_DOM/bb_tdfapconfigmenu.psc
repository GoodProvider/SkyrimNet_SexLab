Function ToggleSLSWhoreSettings()
	if (SLSWhoreLicenseHonoredbool == 1)
		float iq = (Game.GetFormFromFile(0x0D09E8, "SL Survival.esp") as GlobalVariable).GetValue() as float
		float CurrentTime = Utility.GetCurrentGameTime()
		BB_SLS_License_DaysPassed.SetValue(CurrentTime)
		BB_SLS_Whore_License_Expiry.SetValue(iq)
		AddEmptyOption()
		AddTextOption("$SLS_TIME", CurrentTime, OPTION_FLAG_DISABLED)
		AddEmptyOption()
		AddTextOption("$SLS_WHORE",iq as int, OPTION_FLAG_DISABLED)
		AddEmptyOption()
		RegisterForUpdateGameTime(1)
	endif
endFunction

Function ToggleBMWhoreSettings()

	if (SLSWhoreLicenseHonoredbool == 1)
        quest fucko = Game.GetFormFromFile(0x000D62, "Licenses.esp") as Quest
		float iq
		if (fucko as BM_Licenses).hasWhoreLicense == true
		    iq = (fucko as BM_Licenses).whoreLicenseExpirationTime
		else
			iq = -1
		endif
		float CurrentTime = Utility.GetCurrentGameTime()
		BB_SLS_License_DaysPassed.SetValue(CurrentTime)
		BB_SLS_Whore_License_Expiry.SetValue(iq)
		AddEmptyOption()
		AddTextOption("$SLS_TIME", CurrentTime, OPTION_FLAG_DISABLED)
		AddEmptyOption()
		AddTextOption("$BM_WHORE",iq, OPTION_FLAG_DISABLED)
		AddEmptyOption()
		RegisterForUpdateGameTime(1)
	endif
endFunction

